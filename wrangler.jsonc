{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "na-lightsail-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",

  // 这个 Worker 没有 `fetch` handler，公开 URL 只会返回错误，还会白白招来流量。
  // 两条对外路由都关掉。
  "workers_dev": false,
  "preview_urls": false,

  // 只有一个 cron trigger。Workers 免费版每账号允许 5 个，已经用掉 3 个，所以重启
  // 逻辑是在 handler 内部分支处理的，而不是再占一个 trigger。
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "vars": {
    // 实例所在的 Lightsail 区域。这两项都需要操作者自行修改。
    "AWS_REGION": "ap-northeast-1",
    "INSTANCE_NAME": "natsuki",

    // 套餐额度，单位 GiB（2^30 字节）。直接填 Lightsail `GetBundles` 返回的
    // `transferPerMonthInGb`：1 TB 套餐是 1024，2 TB 是 2048，以此类推。
    "QUOTA_GIB": "1024",

    // 达到配额的这个比例时停机。必须落在 (0, 1] 区间内。
    "THRESHOLD": "0.8"

    // 可选。设为 "true" 会抑制所有 StartInstance，适用于你自己把实例停下来维护、
    // 不希望它被拉起来的场景。停机不受影响。其它任何值、或者不设置，都表示正常运行。
    // "MANUAL_HOLD": "true"
  },

  // AWS_ACCESS_KEY_ID 和 AWS_SECRET_ACCESS_KEY 是 secret，永远不要写进 vars。
  // `wrangler secret put` 的具体步骤见 README.md。

  "observability": {
    "enabled": true
  }
}
