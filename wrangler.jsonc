{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "na-lightsail-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",

  // 这个 Worker 没有 `fetch` handler，公开 URL 只会返回错误，还会白白招来流量。
  // 两条对外路由都关掉。
  "workers_dev": false,
  "preview_urls": false,

  // 只有一个 cron trigger。Workers 免费版每账号允许 5 个，已经用掉 3 个，所以重启
  // 逻辑是在 handler 内部分支处理的，而不是再占一个 trigger。
  //
  // 间隔决定检测延迟，而检测延迟决定看门狗能不能赶在超额之前把闸拉下来：一台能跑
  // 1 Gbps 的实例，只需 29 分钟就能烧完默认的 204.8 GiB 余量。
  //
  // 十分钟一次，一天 144 次，每天约 720 次 AWS 调用（正常那一轮 5 次：两个月度查询 +
  // 状态查询 + 突发窗口两次；要动手停机/启动时第 6 次）。频率上更低不是
  // 出于额度 —— Workers 免费版每天 10 万次请求、Lightsail API 也不计费 —— 而是不希望
  // 高频轮询被上游判定为滥用接口。
  //
  // **改这个间隔时，必须同步复核 src/index.js 里的 REACTION_HORIZON_SECONDS。** cron 是
  // 检测回路里最大的一项：`*/2` 时回路 18 分钟、30 分钟视野够用；`*/10` 时回路 26 分钟，
  // 视野必须提到 60 分钟才有 2 倍余量。这两个数是一起变的，不能只改一个。
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "vars": {
    // 实例所在的 Lightsail 区域。这两项都需要操作者自行修改。
    "AWS_REGION": "ap-northeast-1",
    "INSTANCE_NAME": "natsuki",

    // 套餐额度，单位 GiB（2^30 字节）。直接填 Lightsail `GetBundles` 返回的
    // `transferPerMonthInGb`：1 TB 套餐是 1024，2 TB 是 2048，以此类推。
    "QUOTA_GIB": "1024",

    // 达到配额的这个比例时停机。必须落在 (0, 1] 区间内。
    //
    // 这是静态线。它只看月度总量，所以拦不住突然的高速率 —— 那由 src/index.js 里的
    // 突发闸门单独负责。两道防线是叠加的，不是二选一。
    "THRESHOLD": "0.8"

    // 可选。设为 "true" 会抑制所有 StartInstance，适用于你自己把实例停下来维护、
    // 不希望它被拉起来的场景。停机不受影响。其它任何值、或者不设置，都表示正常运行。
    // "MANUAL_HOLD": "true"
  },

  // AWS_ACCESS_KEY_ID 和 AWS_SECRET_ACCESS_KEY 是 secret，永远不要写进 vars。
  // `wrangler secret put` 的具体步骤见 README.md。

  "observability": {
    "enabled": true
  }
}
